{
  "expo": {
    "name": "Fasty24 Expert",
    "slug": "fasty24-expert",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fasty24expert",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fasty24.expert",
      "infoPlist": {
        "UIBackgroundModes": ["location", "remote-notification", "audio"],
        "NSCameraUsageDescription": "Fasty24 Expert needs the camera for KYC documents and arrival photos.",
        "NSPhotoLibraryUsageDescription": "Fasty24 Expert needs photo access to upload KYC documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.fasty24.expert",
      "googleServicesFile": "./google-services.json",
      "versionCode": 8,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withJobOfferFullScreenIntent",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "Fasty24 Expert uses your location while you are online or on a job so we can send nearby work and the customer can see you on the way.",
          "locationAlwaysAndWhenInUsePermission": "Fasty24 Expert shares your location with the customer while you are on the way to a job."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fasty24 Expert to access your photos for KYC documents.",
          "cameraPermission": "Allow Fasty24 Expert to take photos for KYC and arrival verification."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFC400",
          "sounds": [
            "./assets/sounds/job_alert.wav"
          ],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-av",
      "expo-task-manager"
    ],
    "extra": {
      "apiUrl": "https://api.fasty24.com/api/v1",
      "socketUrl": "https://api.fasty24.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "abbb0711-4377-4b61-95b6-11335d0c942a"
      }
    },
    "owner": "fasty24"
  }
}
